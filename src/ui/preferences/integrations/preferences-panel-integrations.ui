<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="FtPreferencesPanelIntegrations" parent="FtPreferencesPanel">
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="content_headerbar">
            <property name="show-title">true</property>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage" id="page">
            <child>
              <object class="AdwPreferencesGroup" id="autostart_group">
                <child>
                  <object class="AdwSwitchRow" id="autostart_switchrow">
                    <property name="title" translatable="yes">Autostart</property>
                    <property name="subtitle" translatable="yes">Automatically launch the app when you log in</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="autostart_label">
                    <property name="label" translatable="yes">The app will start in the background. You'll be able to use the indicator and keyboard shortcuts.</property>
                    <property name="use-markup">false</property>
                    <property name="wrap">true</property>
                    <property name="xalign">0.0</property>
                    <property name="visible">false</property>
                    <property name="margin-top">18</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="body"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="sync_group">
                <property name="title" translatable="yes">Sync</property>
                <property name="description" translatable="yes">Share stats with your other devices through a folder kept in sync by Syncthing or a similar tool. Each device writes only to its own file in the folder.</property>
                <child>
                  <object class="AdwSwitchRow" id="sync_switchrow">
                    <property name="title" translatable="yes">Sync Stats</property>
                    <property name="subtitle" translatable="yes">Timer state stays local to each device</property>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow" id="sync_folder_row">
                    <property name="title" translatable="yes">Shared Folder</property>
                    <property name="subtitle-selectable">true</property>
                    <child type="suffix">
                      <object class="GtkButton" id="sync_folder_button">
                        <property name="label" translatable="yes">Choose…</property>
                        <property name="valign">center</property>
                        <signal name="clicked" handler="on_sync_folder_button_clicked" swapped="no"/>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow" id="sync_status_row">
                    <property name="title" translatable="yes">Status</property>
                    <child type="suffix">
                      <object class="GtkButton" id="sync_now_button">
                        <property name="label" translatable="yes">Sync Now</property>
                        <property name="valign">center</property>
                        <signal name="clicked" handler="on_sync_now_button_clicked" swapped="no"/>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
